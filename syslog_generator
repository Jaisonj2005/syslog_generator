import tkinter as tk
from tkinter import ttk, messagebox
import socket
import datetime
import platform

# Standard Syslog Protocol Mappings (RFC 3164)
FACILITIES = {
    "Kernel (0)": 0, "User-Level (1)": 1, "System Daemon (3)": 3, 
    "Security/Auth (4)": 4, "Syslog Internal (5)": 5, 
    "Network/Local0 (16)": 16, "Network/Local7 (23)": 23
}

SEVERITIES = {
    "Emergency (0)": 0, "Alert (1)": 1, "Critical (2)": 2, 
    "Error (3)": 3, "Warning (4)": 4, "Notice (5)": 5, 
    "Info (6)": 6, "Debug (7)": 7
}

def load_preset(preset_type):
    entry_message.delete(0, tk.END)
    if preset_type == "Cisco Link Down":
        combo_fac.set("Network/Local7 (23)")
        combo_sev.set("Error (3)")
        entry_message.insert(0, "%LINK-3-UPDOWN: Interface GigabitEthernet0/1, changed state to down")
    elif preset_type == "SSH Brute Force":
        combo_fac.set("Security/Auth (4)")
        combo_sev.set("Warning (4)")
        entry_message.insert(0, "sshd[1234]: Failed password for root from 192.168.1.100 port 54321 ssh2")
    elif preset_type == "Firewall Drop":
        combo_fac.set("Network/Local0 (16)")
        combo_sev.set("Notice (5)")
        entry_message.insert(0, "%ASA-4-106023: Deny tcp src outside:192.168.1.50/4444 dst inside:10.0.0.5/80 by access-group")

def send_syslog():
    ip = entry_ip.get().strip()
    port = entry_port.get().strip()
    message = entry_message.get().strip()
    
    if not ip or not port or not message:
        messagebox.showerror("Input Error", "Please fill in all target and message fields.")
        return
        
    try:
        port = int(port)
        # Calculate PRIVAL (Facility * 8 + Severity)
        fac_val = FACILITIES[combo_fac.get()]
        sev_val = SEVERITIES[combo_sev.get()]
        prival = (fac_val * 8) + sev_val
        
        # Construct standard Syslog header
        timestamp = datetime.datetime.now().strftime("%b %d %H:%M:%S")
        hostname = platform.node()
        
        # Final Syslog Packet: <PRIVAL>TIMESTAMP HOSTNAME MESSAGE
        syslog_packet = f"<{prival}>{timestamp} {hostname} {message}"
        
        # Send via UDP Datagram
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.sendto(syslog_packet.encode('utf-8'), (ip, port))
        sock.close()
        
        # Log to UI
        text_log.config(state=tk.NORMAL)
        text_log.insert(tk.END, f"[*] Sent to {ip}:{port}\n")
        text_log.insert(tk.END, f"[>] {syslog_packet}\n\n", "success")
        text_log.see(tk.END)
        text_log.config(state=tk.DISABLED)
        
        lbl_status.config(text="Packet Sent Successfully", fg="#27ae60")
        
    except ValueError:
        messagebox.showerror("Port Error", "Port must be a valid integer (default 514).")
    except Exception as e:
        messagebox.showerror("Network Error", f"Failed to send packet: {str(e)}")
        lbl_status.config(text="Transmission Failed", fg="#c0392b")

