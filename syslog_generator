btn_send = tk.Button(frame, text="Transmit Syslog UDP", command=send_syslog, bg="#e67e22", fg="white", font=("Helvetica", 9, "bold"), width=20)
btn_send.grid(row=3, column=0, sticky="w", pady=(5, 10))

lbl_status = tk.Label(frame, text="Ready", font=("Helvetica", 9, "italic"), fg="#7f8c8d")
